                  <stringProp name="Argument.value">{&#xd;
    &quot;firstname&quot; : &quot;${p_firstname}}&quot;,&#xd;
    &quot;lastname&quot; : &quot;${p_lastname}&quot;,&#xd;
    &quot;totalprice&quot; : 111,&#xd;
    &quot;depositpaid&quot; : true,&#xd;
    &quot;bookingdates&quot; : {&#xd;
        &quot;checkin&quot; : &quot;${__time(yyyy-MM-dd)}&quot;,&#xd;
        &quot;checkout&quot; : &quot;${__time(yyyy-MM-dd)}&quot;&#xd;
    },&#xd;
    &quot;additionalneeds&quot; : &quot;Breakfast&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
